{
  "id": "org.rogplay.webxseries",
  "title": "WebxSeries Scrapper",
  "version": "1.0.0",
  "description": "Scrapes WebxSeries content.",
  "addontype": "scrapperaddon",
  "baseUrl": "https://webxseries.gg",
  
  "catalogScraperRules": {
    "container": ".videos > .video",
    "title": { "type": "text", "selector": ".vtitle" },
    "logo": { "type": "attribute", "attribute": "data-bg" },
    "url": { "type": "attribute", "attribute": "href" }
  },

  "catalogs": [
    {
      "id": "latest",
      "name": "Latest Videos",
      "isSlider": true,
      "url": "https://webxseries.gg/page/{page}/"
    }
  ],

  "categoryScraperRules": {
    "container": ".videos > .video",
    "title": { "type": "text", "selector": ".vtitle" },
    "logo": { "type": "attribute", "attribute": "data-bg" },
    "url": { "type": "attribute", "attribute": "href" }
  },

  "categories": [
    {
      "id": "9redmovies",
      "name": "9RedMovies",
      "url": "https://webxseries.gg/category/9redmovies/page/{page}/"
    },
    {
      "id": "akku",
      "name": "Akku",
      "url": "https://webxseries.gg/category/akku/page/{page}/"
    }
  ],
  
  "search": {
    "url": "https://webxseries.gg/page/{page}/?s={query}",
    "scraperRules": {
      "container": ".videos > .video",
      "title": { "type": "text", "selector": ".vtitle" },
      "logo": { "type": "attribute", "attribute": "data-bg" },
      "url": { "type": "attribute", "attribute": "href" }
    }
  },
  
  "stream": {
    "steps": [
      {
        "type": "regex",
        "pattern": "<source src=\"([^\"]+)\"",
        "flags": "i",
        "group": 1
      }
    ]
  }
}
